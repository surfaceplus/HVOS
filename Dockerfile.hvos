# HVOS Core Dockerfile
FROM python:3.11-slim

WORKDIR /app

# 系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY reality/ ./reality/
COPY hvos_kg_engine.py ./hvos_kg_engine.py
COPY hvos_status.py ./hvos_status.py
COPY self_training.py ./self_training.py
COPY strategy_memory.py ./strategy_memory.py

# 入口脚本
COPY docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "reality.reality_hub", "--action", "collect"]