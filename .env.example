# HVOS 环境变量配置示例
# 复制为 .env 并填入真实值

# ── 数据库 ──────────────────────────────────────────────
POSTGRES_DB=hvos
POSTGRES_USER=hvos
DB_PASSWORD=YOUR_SECURE_PASSWORD

# ── Neo4j ──────────────────────────────────────────────
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# ── MinIO ──────────────────────────────────────────────
MINIO_USER=hvos
MINIO_PASSWORD=YOUR_MINIO_PASSWORD

# ── Traefik / Let's Encrypt ─────────────────────────────
LETSENCRYPT_EMAIL=your@email.com

# ── VPS（woo_to_capital.py 用）─────────────────────────
HVOS_VPS_IP=YOUR_VPS_IP
HVOS_VPS_SSH_USER=root
HVOS_VPS_SSH_PASS=YOUR_SSH_PASSWORD
HVOS_MYSQL_USER=YOUR_MYSQL_USER
HVOS_MYSQL_PASS=YOUR_MYSQL_PASSWORD
HVOS_MYSQL_DB=YOUR_MYSQL_DATABASE
HVOS_WC_TABLE_PREFIX=wp_

# ── WooCommerce / Shopify / Meta / TikTok ──────────────
# 填入对应平台的 access_token / api_key / api_secret
# 参考 reality_config.json 的字段结构

# ── Google Trends API ──────────────────────────────────
# GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# ── SerpAPI（可选）────────────────────────────────────
# SERPAPI_KEY=YOUR_SERPAPI_KEY